# Cache rules for Netlify / Cloudflare Pages (other hosts: see README "Deploying").
# Vite's build output has content hashes in its file names, so it never changes.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Models, textures and screenshots keep their names when replaced: cache for a
# day, then refresh in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
